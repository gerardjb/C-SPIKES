# Opt-in native contract build hook. No production source or default target change.
# Pass -DCMAKE_PROJECT_c_spikes_INCLUDE=<source>/tests/native/contracts/probes.cmake.
function(csp_contract_targets)
 if(NOT C_SPIKES_OBSERVATIONAL_DIAGNOSTICS)
  message(FATAL_ERROR "Observation/context contract targets require diagnostics ON; validate essential OFF behavior separately")
 endif()
 if(NOT C_SPIKES_TEST_CHECKED_CPU OR NOT C_SPIKES_TEST_SWEEP_CPU OR NOT C_SPIKES_TEST_SWEEP_RUN_CPU)
  message(FATAL_ERROR "Contract profile needs all three checked/sweep options ON in a separate CPU build")
 endif()
 if(_pgas_build_gpu)
  message(FATAL_ERROR "This contract profile is CPU-only; it does not admit GPU execution")
 endif()
 set(CSP_CONTRACT_ARMADILLO_INCLUDE "" CACHE PATH "Explicit test-only directory containing the armadillo header")
 set(CSP_CONTRACT_PYTHON_HOME "" CACHE PATH "Prefix of the admitted embedding interpreter; no Della default")
 if(NOT EXISTS "${CSP_CONTRACT_ARMADILLO_INCLUDE}/armadillo")
  message(FATAL_ERROR "Admit test-only Armadillo headers explicitly; do not link an Armadillo runtime")
 endif()
 if(NOT IS_DIRECTORY "${CSP_CONTRACT_PYTHON_HOME}")
  message(FATAL_ERROR "Provide the admitted embedding Python prefix via CSP_CONTRACT_PYTHON_HOME")
 endif()
 if(NOT Python_EXECUTABLE)
  message(FATAL_ERROR "Provide the admitted Python_EXECUTABLE explicitly")
 endif()
 find_package(Python COMPONENTS Interpreter Development.Embed NumPy REQUIRED)
 add_library(csp_contract_standalone OBJECT "${CMAKE_SOURCE_DIR}/tests/native/contracts/standalone.cpp")
 target_include_directories(csp_contract_standalone PRIVATE "${CMAKE_SOURCE_DIR}/src/c_spikes/pgas/include")
 target_compile_features(csp_contract_standalone PRIVATE cxx_std_17)
 target_compile_definitions(csp_contract_standalone PRIVATE USE_GPU=0)
 target_link_libraries(csp_contract_standalone PRIVATE pybind11::module ${PGAS_COMMON_LIBS})
 foreach(name g2e g2g g2i g2j g2o g2r g2t g2v g2w g2y algorithm amplitude brightness checked_math equilibrium_bridge checked_transactions diagnostic_context params_layout collector factory sweep_preparation sweep_run)
  add_executable(csp_contract_${name} "${CMAKE_SOURCE_DIR}/tests/native/contracts/${name}.cpp" $<TARGET_OBJECTS:pgas_obj_cpu>)
  target_include_directories(csp_contract_${name} PRIVATE "${CMAKE_SOURCE_DIR}/src/c_spikes/pgas/include" "${CMAKE_SOURCE_DIR}/src/c_spikes/pgas" "${CMAKE_SOURCE_DIR}/tests/native/g1e" "${CSP_CONTRACT_ARMADILLO_INCLUDE}")
  target_compile_features(csp_contract_${name} PRIVATE cxx_std_17)
  target_compile_definitions(csp_contract_${name} PRIVATE USE_GPU=0 C_SPIKES_CHECKED_CPU C_SPIKES_CHECKED_TESTING C_SPIKES_CHECKED_SWEEP_CPU C_SPIKES_CHECKED_SWEEP_RUN_CPU G2E_CANDIDATE G2G_CANDIDATE G2I_CANDIDATE ARMA_DONT_USE_WRAPPER)
  target_link_libraries(csp_contract_${name} PRIVATE ${PGAS_COMMON_LIBS})
 endforeach()
 target_link_libraries(csp_contract_equilibrium_bridge PRIVATE pybind11::embed Python::Python)
 target_compile_definitions(csp_contract_equilibrium_bridge PRIVATE G2AB_PYTHON_HOME="${CSP_CONTRACT_PYTHON_HOME}")
 add_executable(csp_contract_solver_boundaries "${CMAKE_SOURCE_DIR}/tests/native/contracts/solver_boundaries.cpp" "${CMAKE_SOURCE_DIR}/src/c_spikes/pgas/legacy_equilibrium_compat.cpp")
 target_include_directories(csp_contract_solver_boundaries PRIVATE "${CMAKE_SOURCE_DIR}/src/c_spikes/pgas" "${CMAKE_SOURCE_DIR}/src/c_spikes/pgas/include" "${CSP_CONTRACT_ARMADILLO_INCLUDE}")
 target_compile_features(csp_contract_solver_boundaries PRIVATE cxx_std_17)
 target_compile_definitions(csp_contract_solver_boundaries PRIVATE CSP_G2AL_TEST_OBSERVER ARMA_DONT_USE_WRAPPER)
 target_link_options(csp_contract_solver_boundaries PRIVATE "-Wl,--wrap=dgesdd_")
 target_link_libraries(csp_contract_solver_boundaries PRIVATE csp_numerical_provider dl)
endfunction()
cmake_language(DEFER CALL csp_contract_targets)
