# Additional current fixtures selected with C_SPIKES_TEST_RESAMPLING.
foreach(mode off on)
  add_executable(test_observations_${mode} tests/native/test_observational_diagnostics.cpp)
  target_include_directories(test_observations_${mode} PRIVATE src/c_spikes/pgas/include)
  target_compile_features(test_observations_${mode} PRIVATE cxx_std_17)
  if(mode STREQUAL "on")
    target_compile_definitions(test_observations_${mode} PRIVATE C_SPIKES_OBSERVATIONAL_DIAGNOSTICS=1)
  else()
    target_compile_definitions(test_observations_${mode} PRIVATE C_SPIKES_OBSERVATIONAL_DIAGNOSTICS=0)
  endif()
  add_test(NAME observations_${mode} COMMAND test_observations_${mode})
endforeach()
