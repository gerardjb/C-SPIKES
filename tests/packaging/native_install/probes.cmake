set(G4A_PROBE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(g4a_probes)
 target_link_options(pgas_bound_cpu PRIVATE "-Wl,-Map,${CMAKE_BINARY_DIR}/pgas_bound_cpu.map")
 foreach(name header signatures)
  add_library(g4a_${name} OBJECT ${G4A_PROBE_DIR}/${name}.cpp)
  target_compile_features(g4a_${name} PRIVATE cxx_std_17)
  target_include_directories(g4a_${name} PRIVATE ${CMAKE_SOURCE_DIR}/src/c_spikes/pgas/include)
  target_link_libraries(g4a_${name} PRIVATE ${PGAS_COMMON_LIBS})
 endforeach()
endfunction()
# Evaluation is deferred until all normal targets exist.
cmake_language(DEFER CALL g4a_probes)
